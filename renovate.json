{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["on monday"],
  "minimumReleaseAge": "25 hours",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "CI (lint + tsc + build) runs on every PR and gates the merge",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Majors wait on the dependency dashboard until picked by hand",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "docker-compose points at the image this repo publishes",
      "matchPackageNames": ["ghcr.io/gastbob40/nats-ui"],
      "enabled": false
    }
  ]
}
